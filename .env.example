# Backend only. Keep the existing .env; do not commit real keys.
DATA_GO_KR_SERVICE_KEY=
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=
SGIS_BASE_URL=https://sgisapi.kostat.go.kr/OpenAPI3
# Requested SGIS year; older published years are tried automatically (max 5 back).
SGIS_BASE_YEAR=2024
# VWorld: 인증키 관리 > 활용API에서 '2D데이터 API' 체크 필요. 서비스URL과 VWORLD_DOMAIN을 같게 유지.
VWORLD_API_KEY=
VWORLD_DOMAIN=http://localhost
VWORLD_DATA_URL=https://api.vworld.kr/req/data
KMA_ASOS_BASE_URL=https://apis.data.go.kr/1360000/AsosDalyInfoService
KAPT_ENERGY_BASE_URL=https://apis.data.go.kr/1613000/ApHusEnergyUseInfoOfferServiceV2
KAPT_ENERGY_REQUEST_DELAY_MS=250
# Local report writer (Ollama). Leave unset for qwen2.5:1.5b; set to a fine-tuned model only after llm-eval (scripts/llm/README.md).
# OLLAMA_MODEL=carbon-area-narrator
